{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "glifo",
  "compatibility_date": "2026-10-12",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": [
      "/admin",
      "/admin/*",
      "/api/admin/*"
    ]
  },
  "main": "worker/index.mjs",
  "durable_objects": {
    "bindings": [
      {
        "name": "WORKSPACE",
        "class_name": "GlifoWorkspace"
      }
    ]
  },
  "migrations": [
    {
      "tag": "glifo-admin-v1",
      "new_sqlite_classes": [
        "GlifoWorkspace"
      ]
    }
  ]
}
