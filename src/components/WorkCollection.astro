---
import { projects } from '../data/site';
import ProjectVisual from './ProjectVisual.astro';
const selection=projects.filter(p=>p.slug!=='glifo');
---
<section class="work-collection section wrap" id="outros-trabalhos" aria-labelledby="collection-title"><div class="section-heading"><div><p class="eyebrow">Outros firmamentos / Trabalhos selecionados</p><h2 id="collection-title">O mesmo cuidado.<br/><em>Outras linguagens.</em></h2></div><p class="section-description">Uma mesa de jogo, uma coleção de livros, um sistema pessoal e marcas profissionais. Cada projeto pede seu próprio desenho.</p></div><div class="collection-layout"><div class="collection-tabs" role="tablist" aria-label="Projetos selecionados" aria-orientation="vertical">{selection.map((p,i)=><button id={`project-tab-${p.slug}`} type="button" role="tab" aria-controls={`project-panel-${p.slug}`} aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1} data-project-tab><span>0{i+1}</span><strong>{p.title}</strong><small>{p.categories.join(' / ')}</small><span class="project-tab-arrow" aria-hidden="true">↗</span></button>)}</div><div class="collection-panels">{selection.map((p,i)=><article role="tabpanel" id={`project-panel-${p.slug}`} aria-labelledby={`project-tab-${p.slug}`} hidden={i!==0} class="collection-panel"><a href={`/trabalhos/${p.slug}/`} aria-label={`Explorar ${p.title}`}><ProjectVisual project={p}/></a><div class="collection-caption"><div><h3>{p.lead}</h3><p>{p.summary}</p></div><a href={`/trabalhos/${p.slug}/`} class="quiet-link">Explorar o projeto ↗</a></div><p class="visual-provenance">{p.caption}</p></article>)}</div></div><a href="/trabalhos/" class="line-link collection-all">Percorrer todos os trabalhos <span aria-hidden="true">↗</span></a></section>
