---
import type {IdentityBoard as Board} from '../data/identities';
import {identities,identityEssences} from '../data/identities';
import '../styles/identity-fonts.css';
import '../styles/identity-board.css';
interface Props {board:Board}
const {board:b}=Astro.props;
const essence=identityEssences[b.slug as keyof typeof identityEssences];
---
<article class:list={['identity-board',`identity-${b.theme}`]}>
 <div class="identity-document-colophon wrap"><span>GLIFO / CADERNO DE IDENTIDADES</span><span>{b.name} / 2026</span></div>
 <header class="identity-cover wrap"><div class="identity-cover-copy"><p class="eyebrow">Documento de marca / {b.name}</p><h1>{b.name}</h1><p class="identity-subtitle">{b.subtitle}</p><p class="identity-intro">{b.intro}</p><a class="quiet-link" href={`/trabalhos/${b.caseSlug}/`}>Voltar ao projeto <span aria-hidden="true">↗</span></a></div><div class="identity-cover-art"><img src={b.hero} alt={`Identidade de ${b.name}`} width="1600" height="1000" fetchpriority="high"/></div><nav class="identity-local-nav" aria-label="Neste documento"><a href="#essencia">Essência</a><a href="#assinaturas">Assinaturas</a><a href="#paleta">Cores</a><a href="#tipografia">Tipografia</a><a href="#linguagem">Linguagem</a><a href="#materiais">Aplicações</a></nav></header>
 <section class="identity-vision wrap" id="essencia" aria-label="Vision board e essência da marca"><div class="identity-essence"><p class="eyebrow">01 / A essência</p><h2>{essence.title}</h2><p>{essence.copy}</p><ul>{essence.traits.map(trait=><li>{trait}</li>)}</ul></div><div class="identity-mosaic"><div class="identity-mosaic-mark"><img src={b.slug==='glifo'?'/brand/symbol.png':b.hero} alt={`Expressão visual de ${b.name}`} width="1600" height="1000" loading="lazy"/></div><div class="identity-mosaic-type" style={`font-family:'${b.types[0].family}',serif`}><span>Aa</span><strong>{essence.word}</strong><p>{essence.note}</p></div><div class="identity-mosaic-palette" aria-label="Cores da identidade">{b.colors.map(color=><span style={`background:${color.hex}`} title={`${color.name} ${color.hex}`}></span>)}</div></div></section>
 <section class="identity-section wrap" id="assinaturas"><div class="identity-section-title"><p class="eyebrow">02 / O que torna a marca reconhecível</p><h2>Assinaturas</h2></div><div class:list={['identity-mark-grid',{'identity-mark-grid-many':b.marks.length>2}]}>{b.marks.map((mark,i)=><figure><button type="button" class:list={['identity-image-trigger','identity-mark',`identity-mark-${i}`]} data-board-image={mark.image} data-board-caption={mark.caption} aria-label={`Ampliar: ${mark.title}`}><img src={mark.image} alt={mark.title} loading="lazy" width="1600" height="1000"/><span class="image-expand" aria-hidden="true">↗</span></button><figcaption><h3>{mark.title}</h3><p>{mark.caption}</p></figcaption></figure>)}</div></section>
 <section class="identity-section wrap" id="paleta"><div class="identity-section-title"><p class="eyebrow">Cor, contraste e função</p><h2>A paleta</h2></div><div class="identity-color-grid">{b.colors.map(color=><div class="identity-color"><button type="button" data-copy-color={color.hex} style={`background:${color.hex}`} aria-label={`Copiar ${color.name}, ${color.hex}`}><span aria-hidden="true">+</span></button><h3>{color.name}</h3><code>{color.hex}</code><p>{color.role}</p></div>)}</div><p class="identity-small-note">Selecione uma cor para copiar seu código.</p></section>
 <section class="identity-section wrap" id="tipografia"><div class="identity-section-title"><p class="eyebrow">As formas de leitura</p><h2>Tipografia</h2></div><div class="identity-types">{b.types.map(type=><div class="identity-type"><div><h3>{type.name}</h3><p>{type.role}</p></div><p class="identity-type-specimen" style={`font-family:'${type.family}',serif;font-weight:${type.weight}`}>{type.sample}</p></div>)}</div></section>
 <section class="identity-section wrap" id="linguagem"><div class="identity-section-title"><p class="eyebrow">Como as partes se relacionam</p><h2>A linguagem</h2></div>{b.slug==='glifo'&&<div class="glyph-sheet" aria-label="Estudo do imaginário de glifos e constelações"><div class="glyph-letters" aria-hidden="true"><span>g</span><span>æ</span><span>∴</span><span>∞</span></div><svg viewBox="0 0 1000 220" aria-hidden="true"><path d="M80 160L190 55L330 130L470 70L610 170L780 60L920 130"/>{[[80,160],[190,55],[330,130],[470,70],[610,170],[780,60],[920,130]].map(([x,y])=><circle cx={x} cy={y} r="3"/>)}</svg><p>Formas de letras e sinais, apresentadas como estudo de linguagem. O sistema de glifos pode crescer conforme as mensagens da marca.</p></div>}<div class="identity-language">{b.language.map(item=><div><h3>{item.title}</h3><p>{item.copy}</p></div>)}</div>{b.slug==='christiano-tadeu'&&<div class="identity-site-structure"><div><span class="eyebrow">Site público</span><h3>Informação e diagnóstico</h3><p>Produtos, aplicações, conteúdo e caminhos de contato.</p><a class="quiet-link" href="https://caminhoes.christianotadeu.workers.dev" target="_blank" rel="noopener noreferrer">Visitar o site completo ↗</a></div><div><span class="eyebrow">Gestão / Acesso restrito</span><h3>Organização do atendimento</h3><p>Área interna para os dados dos clientes e o acompanhamento comercial.</p><span class="identity-private-note">Apresentação da função, sem exibição de registros privados.</span></div></div>}{b.slug==='tdv'&&<a href="/trabalhos/tadeon/" class="line-link">Conhecer o projeto Tadeon Nexus ↗</a>}</section>
 <section class="identity-section wrap" id="materiais"><div class="identity-section-title"><p class="eyebrow">A identidade em uso</p><h2>Materiais e<br/>aplicações</h2></div><div class="identity-material-grid">{b.materials.map(material=><figure><button class="identity-image-trigger identity-material" type="button" data-board-image={material.image} data-board-caption={material.caption} aria-label={`Ampliar: ${material.title}`}><img src={material.image} alt={material.title} width="1600" height="1100" loading="lazy"/><span class="image-expand" aria-hidden="true">↗</span></button><figcaption><h3>{material.title}</h3><p>{material.caption}</p></figcaption></figure>)}</div></section>
 <footer class="identity-end wrap"><p class="eyebrow">Outras identidades</p><div>{identities.filter(x=>x.slug!==b.slug).map(board=><a href={`/identidades/${board.slug}/`}><span>{board.name}</span><span aria-hidden="true">↗</span></a>)}</div></footer>
</article>
<dialog class="board-lightbox" data-board-lightbox aria-label="Imagem da identidade ampliada"><div class="board-lightbox-bar"><button type="button" data-board-prev aria-label="Imagem anterior">←</button><span data-board-image-count></span><input type="range" data-board-zoom min="100" max="250" value="100" step="25" aria-label="Ampliação da imagem"/><button type="button" data-board-next aria-label="Próxima imagem">→</button><button type="button" class="board-lightbox-close" data-board-close aria-label="Fechar imagem ampliada">×</button></div><div class="board-lightbox-image"><img data-board-full-image alt=""/></div><p data-board-full-caption></p></dialog>
