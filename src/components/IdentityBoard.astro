---
import Icon from './Icon.astro';
import IdentityLab from './IdentityLab.astro';
import type {IdentityBoard as Board} from '../data/identities';
import {projects} from '../data/site';
import {identities,identityEssences} from '../data/identities';
import '../styles/identity-fonts.css';
import '../styles/identity-board.css';
interface Props {board:Board; embedded?:boolean; prefix?:string}
const {board:b,embedded=false,prefix=''}=Astro.props;
const Heading=embedded?'h2':'h1';
const period=b.caseSlug==='acolher-comissao'?projects.find(p=>p.slug===b.caseSlug)!.year:'2026';
const essence=identityEssences[b.slug as keyof typeof identityEssences];
---
<article id={prefix?`${prefix}identidade`:undefined} class:list={['identity-board',`identity-${b.theme}`]}>
 <div class="identity-document-colophon wrap"><span>GLIFO / CADERNO DE IDENTIDADES</span><span>{b.name} / {period}</span></div>
 <header class="identity-cover wrap"><div class="identity-cover-copy"><p class="eyebrow">Documento de marca / {b.name}</p><Heading class="identity-board-name">{b.slug==='glifo'?<img class="document-logotype" src="/brand/logo.png" alt="Glifo" width="1394" height="1128"/>:b.name}</Heading><p class="identity-subtitle">{b.subtitle}</p><p class="identity-intro">{b.intro}</p><a class="quiet-link" href={`/trabalhos/${b.caseSlug}/`}>Voltar ao projeto <span aria-hidden="true"><Icon name="arrow"/></span></a></div><div class="identity-cover-art"><img src={b.hero} alt={`Identidade de ${b.name}`} width="1600" height="1000" fetchpriority="high"/></div><nav class="identity-local-nav" aria-label="Neste documento"><a href={`#${prefix}essencia`}>Essência</a><a href={`#${prefix}assinaturas`}>Assinaturas</a><a href={`#${prefix}paleta`}>Cores</a><a href={`#${prefix}tipografia`}>Tipografia</a><a href={`#${prefix}linguagem`}>Linguagem</a><a href={`#${prefix}materiais`}>Aplicações</a></nav></header>
 <section class="identity-vision wrap" id={`${prefix}essencia`} aria-label="Vision board e essência da marca"><div class="identity-essence"><p class="eyebrow">01 / A essência</p><h2>{essence.title}</h2><p>{essence.copy}</p><ul>{essence.traits.map(trait=><li>{trait}</li>)}</ul></div><div class="identity-mosaic"><div class="identity-mosaic-mark"><img src={b.slug==='glifo'?'/brand/symbol.png':b.hero} alt={`Expressão visual de ${b.name}`} width="1600" height="1000" loading="lazy"/></div><div class="identity-mosaic-type" style={`font-family:'${b.types[0].family}',serif`}><span>Aa</span><strong>{essence.word}</strong><p>{essence.note}</p></div><div class="identity-mosaic-palette" aria-label="Cores da identidade">{b.colors.map(color=><span style={`background:${color.hex}`} title={`${color.name} ${color.hex}`}></span>)}</div></div></section>
 <section class="identity-section wrap" id={`${prefix}assinaturas`}><div class="identity-section-title"><p class="eyebrow">02 / O que torna a marca reconhecível</p><h2>Assinaturas</h2></div><div class:list={['identity-mark-grid',{'identity-mark-grid-many':b.marks.length>2}]}>{b.marks.map((mark,i)=><figure><button type="button" class:list={['identity-image-trigger','identity-mark',`identity-mark-${i}`]} data-board-image={mark.image} data-board-caption={mark.caption} aria-label={`Ampliar: ${mark.title}`}><img src={mark.image} alt={mark.title} loading="lazy" width="1600" height="1000"/><span class="image-expand" aria-hidden="true"><Icon name="arrow"/></span></button><figcaption><h3>{mark.title}</h3><p>{mark.caption}</p></figcaption></figure>)}</div></section>
 <section class="identity-section wrap" id={`${prefix}paleta`}><div class="identity-section-title"><p class="eyebrow">03 / Cor, contraste e função</p><h2>A paleta</h2></div><div class="identity-color-grid">{b.colors.map(color=><div class="identity-color"><button type="button" data-copy-color={color.hex} style={`background:${color.hex}`} aria-label={`Copiar ${color.name}, ${color.hex}`}><span aria-hidden="true">+</span></button><h3>{color.name}</h3><code>{color.hex}</code><p>{color.role}</p></div>)}</div><p class="identity-small-note">Selecione uma cor para copiar seu código.</p></section>
 <section class="identity-section wrap" id={`${prefix}tipografia`}><div class="identity-section-title"><p class="eyebrow">04 / As formas de leitura</p><h2>Tipografia</h2></div><div class="identity-types">{b.types.map(type=><div class="identity-type"><div><h3>{type.name}</h3><p>{type.role}</p></div><p class="identity-type-specimen" style={`font-family:'${type.family}',serif;font-weight:${type.weight}`}>{type.sample}</p></div>)}</div><IdentityLab board={b} prefix={prefix}/></section>
 <section class="identity-section wrap" id={`${prefix}linguagem`}><div class="identity-section-title"><p class="eyebrow">05 / Como as partes se relacionam</p><h2>A linguagem</h2></div>{b.slug==='glifo'&&<div class="glyph-sheet" aria-label="Estudo do imaginário de glifos e constelações"><div class="glyph-letters" aria-hidden="true"><span>g</span><span>æ</span><span>∴</span><span>∞</span></div><svg viewBox="0 0 1000 220" aria-hidden="true"><path d="M80 160L190 55L330 130L470 70L610 170L780 60L920 130"/>{[[80,160],[190,55],[330,130],[470,70],[610,170],[780,60],[920,130]].map(([x,y])=><circle cx={x} cy={y} r="3"/>)}</svg><p>Formas de letras e sinais, apresentadas como estudo de linguagem. O sistema de glifos pode crescer conforme as mensagens da marca.</p></div>}<div class="identity-language">{b.language.map(item=><div><h3>{item.title}</h3><p>{item.copy}</p></div>)}</div>{b.slug==='christiano-tadeu'&&<div class="identity-site-structure"><div><span class="eyebrow">Site público</span><h3>Informação e diagnóstico</h3><p>Produtos, aplicações, conteúdo e caminhos de contato.</p><a class="quiet-link" href="https://caminhoes.christianotadeu.workers.dev" target="_blank" rel="noopener noreferrer">Visitar o site completo <Icon name="arrow"/></a></div><div><span class="eyebrow">Gestão / Acesso restrito</span><h3>Organização do atendimento</h3><p>Área interna para os dados dos clientes e o acompanhamento comercial.</p><span class="identity-private-note">Apresentação da função, sem exibição de registros privados.</span></div></div>}{b.slug==='tdv'&&<a href="/trabalhos/tadeon/" class="line-link">Conhecer o projeto Tadeon Nexus <Icon name="arrow"/></a>}</section>
 <section class="identity-section wrap" id={`${prefix}materiais`}><div class="identity-section-title"><p class="eyebrow">06 / A identidade em uso</p><h2>Materiais e<br/>aplicações</h2></div><div class="identity-material-grid">{b.materials.map(material=><figure><button class="identity-image-trigger identity-material" type="button" data-board-image={material.image} data-board-caption={material.caption} aria-label={`Ampliar: ${material.title}`}><img src={material.image} alt={material.title} width="1600" height="1100" loading="lazy"/><span class="image-expand" aria-hidden="true"><Icon name="arrow"/></span></button><figcaption><h3>{material.title}</h3><p>{material.caption}</p></figcaption></figure>)}</div></section>
 {!embedded&&<footer class="identity-end wrap"><p class="eyebrow">Outras identidades</p><div>{identities.filter(x=>x.slug!==b.slug).map(board=><a href={`/identidades/${board.slug}/`}><span>{board.name}</span><span aria-hidden="true"><Icon name="arrow"/></span></a>)}</div></footer>}
</article>
