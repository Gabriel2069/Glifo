---
import type { Project } from '../data/site';
interface Props { project:Project; eager?:boolean }
const { project:p,eager=false }=Astro.props;
---
<div class:list={['project-art',`art-${p.theme||'glifo'}`,`art-${p.kind||'screen'}`]}><div class="project-art-orbit" aria-hidden="true"></div>{p.slug==='acolher-comissao'?<div class="paired-cover-marks"><figure><img src="/identities/acolher/acolher.webp" alt="Projeto Acolher" width="1000" height="1000" loading={eager?'eager':'lazy'}/><figcaption>Projeto Acolher</figcaption></figure><figure><img src="/identities/acolher/comissao.webp" alt="Comissão Grão de Mostarda" width="1000" height="1000" loading={eager?'eager':'lazy'}/><figcaption>Comissão Grão de Mostarda</figcaption></figure></div>:<img src={p.image} alt={p.alt} width={p.kind==='book'?1061:1440} height={p.kind==='book'?1500:1000} loading={eager?'eager':'lazy'}/>}<span class="project-art-label" aria-hidden="true">{p.title} / {p.categories[0]}</span></div>
