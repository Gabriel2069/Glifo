---
import Icon from './Icon.astro';
import MobileShelf from './MobileShelf.astro';
import {services,site,projects} from '../data/site';
---
<section class="service-offer section wrap" id="servicos" aria-labelledby="services-title"><div class="section-heading"><div><p class="eyebrow">O que podemos construir</p><h2 id="services-title">Seu projeto<br/><em>pede uma forma.</em></h2></div><p class="section-description">Uma identidade, uma página, uma coleção de materiais. O trabalho é combinado a partir do que você precisa comunicar e de onde ele será usado.</p></div><MobileShelf target="service-shelf" label="Serviços" total={services.length}/><div class="service-offer-grid mobile-shelf" id="service-shelf" data-mobile-shelf tabindex="0" role="region" aria-label="Serviços disponíveis">{services.map((service,i)=><article><span class="service-number">0{i+1}</span><h3>{service.title}</h3><p>{service.copy}</p><ul>{service.items.map(item=><li>{item}</li>)}</ul><a class="service-proof" href={`/trabalhos/${service.example}/`}><span>UM TRABALHO PARA CONHECER</span>{projects.find(project=>project.slug===service.example)!.title} <Icon name="arrow"/></a><a href={`${site.contact.whatsapp}?text=${encodeURIComponent(`Olá, Tadeu! Quero conversar sobre ${service.title.toLowerCase()} para meu projeto.`)}`} target="_blank" rel="noopener noreferrer">Conversar sobre este serviço <span aria-hidden="true"><Icon name="arrow"/></span></a></article>)}</div><p class="service-offer-note">Cada projeto tem escopo e entregas combinados. Acompanhamentos contínuos são definidos à parte.</p></section>
