---
import Icon from './Icon.astro';
---
<dialog class="board-lightbox" data-board-lightbox aria-describedby="board-full-caption" aria-label="Imagem da identidade ampliada"><div class="board-lightbox-bar"><button type="button" data-board-prev aria-label="Imagem anterior"><Icon name="left"/></button><span data-board-image-count></span><input type="range" data-board-zoom min="100" max="250" value="100" step="25" aria-label="Ampliação da imagem"/><button type="button" data-board-next aria-label="Próxima imagem"><Icon name="right"/></button><button type="button" class="board-lightbox-close" data-board-close autofocus aria-label="Fechar imagem ampliada"><Icon name="close"/></button></div><div class="board-lightbox-image"><img data-board-full-image alt=""/></div><p id="board-full-caption" data-board-full-caption></p></dialog>
