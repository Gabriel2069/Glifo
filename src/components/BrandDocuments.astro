---
import Icon from './Icon.astro';
import MobileShelf from './MobileShelf.astro';
import {identities} from '../data/identities';
---
<section class="brand-documents section wrap" id="identidades" aria-labelledby="documents-title"><div class="section-heading"><div><p class="eyebrow">Documentos de marca / Entre para conhecer</p><h2 id="documents-title">A identidade,<br/><em>por dentro.</em></h2></div><p class="section-description">Abra um documento para ver a essência, as assinaturas, as cores e as escolhas que ligam os materiais de cada marca.</p></div><MobileShelf target="document-shelf" label="Documentos de marca" total={identities.length}/><div class="brand-document-grid mobile-shelf" id="document-shelf" data-mobile-shelf tabindex="0" role="region" aria-label="Documentos de identidade visual">{identities.map((board,i)=><a class:list={['brand-document-card',`document-card-${board.theme}`]} href={`/identidades/${board.slug}/`}><div class="brand-document-image"><img src={board.hero} alt="" width="1600" height="1000" loading="lazy"/><span>0{i+1} / DOCUMENTO DE MARCA</span></div><h3>{board.name}</h3><p>{board.subtitle}</p><strong>Abrir identidade <span aria-hidden="true"><Icon name="arrow"/></span></strong></a>)}</div></section>
