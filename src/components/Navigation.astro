---
import Icon from './Icon.astro';
import {site,projects} from '../data/site';
const entries=[['Trabalhos','/trabalhos/','O acervo'],['Serviços','/#servicos','O que construímos'],['A Glifo','/#glifo','Os sinais e a marca'],['O processo','/#processo','Da conversa à entrega'],['Identidades','/identidades/','Os documentos']];
const selection=['christiano-tadeu','delfas-corpore','tdv-editorial'].map(slug=>projects.find(p=>p.slug===slug)!);
---
<header class="site-header"><a class="brand" href="/" aria-label="Glifo início"><img src="/brand/logo.png" alt="Glifo" width="1394" height="1128"/><span>ESTÚDIO AUTORAL</span></a><nav class="desktop-nav" aria-label="Navegação principal">{entries.map(([label,href])=><a href={href} data-navigation-link>{label}<span class="navigation-marker" aria-hidden="true"></span></a>)}</nav><div class="header-actions"><a class="contact-link" href={site.contact.whatsapp} target="_blank" rel="noopener noreferrer">Conversar <Icon/></a><button class="icon-button" data-motion aria-label="Pausar animações" aria-pressed="false" type="button"><Icon name="motion"/></button><button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu">Menu <Icon name="menu"/></button></div></header>
<div class="header-sentinel" aria-hidden="true"></div>
<dialog id="mobile-menu" class="mobile-menu" aria-label="Explorar a Glifo"><div class="navigation-top"><a href="/" aria-label="Glifo início"><img src="/brand/logo.png" alt="Glifo" width="1394" height="1128"/></a><span>UM CAMINHO ENTRE OS SINAIS</span><button type="button" data-menu-close autofocus aria-label="Fechar menu">Fechar <Icon name="close"/></button></div><div class="navigation-layout"><nav aria-label="Navegação completa">{entries.map(([label,href,note],i)=><a href={href} data-navigation-link><span class="navigation-number">0{i+1}</span><div><strong>{label}</strong><small>{note}</small></div><Icon/></a>)}</nav><aside class="navigation-aside"><p class="eyebrow">Alguns trabalhos para conhecer</p><div>{selection.map(project=><a href={`/trabalhos/${project.slug}/`}><img src={project.image} alt="" width="160" height="110" loading="lazy"/><span>{project.title}<small>{project.categories[0]}</small></span><Icon/></a>)}</div><a class="navigation-contact" href={site.contact.whatsapp} target="_blank" rel="noopener noreferrer"><span>Uma ideia em mente?</span><strong>Conversar com Tadeu</strong><Icon/></a></aside></div><div class="navigation-colophon"><span>IDEIA · FORMA · PRESENÇA</span><span>POR GABRIEL TADEU</span></div></dialog>
