---
import Icon from './Icon.astro';
const points=[[96,170],[190,76],[314,110],[388,222],[302,342],[158,324],[232,218]];
---
<div class="glyph-instrument" data-glyph-instrument aria-label="Da estrela ao glifo">
 <div class="glyph-instrument-art" aria-hidden="true">
  <svg viewBox="0 0 480 440" class="glyph-diagram"><circle class="glyph-perimeter" cx="240" cy="220" r="188"/><g class="glyph-connections"><path d="M96 170L190 76L314 110L388 222L302 342L158 324Z"/><path d="M190 76L232 218L302 342M96 170L232 218L388 222M158 324L232 218L314 110"/></g><g class="glyph-dots">{points.map(([x,y],i)=><g><circle cx={x} cy={y} r="11" class="glyph-dot-halo"/><circle cx={x} cy={y} r={i===6?3:2}/></g>)}</g><g class="glyph-coordinate-notes"><text x="87" y="146">01</text><text x="322" y="90">03</text><text x="310" y="366">05</text></g></svg>
  <div class="glyph-fragments"><span>æ</span><span>∴</span><span>g</span></div>
  <div class="glyph-resolved"><img src="/brand/symbol.png" alt="" width="1254" height="1254"/><img src="/brand/logo.png" alt="" width="1394" height="1128"/></div>
 </div>
 <div class="glyph-instrument-caption"><span>ESTUDO DE RELAÇÕES</span><strong data-glyph-caption>Um ponto ainda não conta a figura.</strong></div>
 <div class="glyph-phase-controls" role="group" aria-label="Explorar a formação do glifo"><button type="button" data-glyph-phase="0" aria-pressed="true">01 · Sinais</button><button type="button" data-glyph-phase="1" aria-pressed="false">02 · Relações</button><button type="button" data-glyph-phase="2" aria-pressed="false">03 · Leitura</button></div>
 <button class="glyph-follow quiet-button" type="button" data-glyph-follow hidden>Voltar a acompanhar a leitura <Icon name="down"/></button>
</div>
