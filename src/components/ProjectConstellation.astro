---
import {projects} from '../data/site';
import ProjectVisual from './ProjectVisual.astro';
const positions=[[18,32],[47,19],[78,34],[24,74],[55,68],[83,77]];
const slugs=['christiano-tadeu','delfas-corpore','acolher-comissao','tdv-editorial','tadeon','nexos'];
const selection=slugs.map(slug=>projects.find(p=>p.slug===slug)!);
---
<section class="project-cosmos section wrap" data-project-cosmos aria-labelledby="cosmos-title">
 <div class="section-heading"><div><p class="eyebrow">Um acervo de relações</p><h2 id="cosmos-title">Cada trabalho<br/><em>encontra sua figura.</em></h2></div><p class="section-description">Uma identidade chega ao site. Uma coleção de livros continua numa interface. Explore os pontos para conhecer esses encontros e entrar nos projetos.</p></div>
 <div class="cosmos-layout"><div class="cosmos-chart"><svg viewBox="0 0 1000 500" aria-hidden="true" preserveAspectRatio="none"><ellipse cx="500" cy="250" rx="465" ry="220"/>{positions.map(([x,y],i)=><path data-cosmos-ray={i} d={`M500 250 Q${x*10} 250 ${x*10} ${y*5}`}/>)}<circle cx="500" cy="250" r="4"/></svg><span class="cosmos-origin" aria-hidden="true">✦<small>GLIFO</small></span>{selection.map((project,i)=><button type="button" class="cosmos-point" style={`--point-x:${positions[i][0]}%;--point-y:${positions[i][1]}%`} data-cosmos-point={i} aria-pressed={i===0?'true':'false'} aria-controls={`cosmos-project-${project.slug}`}><span aria-hidden="true">✧</span><strong>{project.title}</strong><small>{project.categories[0]}</small></button>)}<p class="cosmos-chart-note">SELECIONE UMA FIGURA / CONHEÇA O TRABALHO</p></div>
 <div class="cosmos-readings">{selection.map((project,i)=><article id={`cosmos-project-${project.slug}`} data-cosmos-panel hidden={i!==0}><ProjectVisual project={project}/><p class="eyebrow">0{i+1} / {project.categories.join(' · ')}</p><h3>{project.title}</h3><p>{project.lead}</p><div class="project-entry-links"><a class="quiet-link" href={`/trabalhos/${project.slug}/`}>Entrar no projeto ↗</a>{project.board&&<a class="quiet-link" href={`/identidades/${project.board}/`}>Ver a identidade ↗</a>}</div></article>)}</div></div>
</section>
