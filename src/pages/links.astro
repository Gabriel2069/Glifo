---
import Motto from '../components/Motto.astro';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import {site,projects} from '../data/site';
const entries=[{label:'Conversar sobre um projeto',note:'Conte sua ideia pelo WhatsApp.',icon:'chat' as const,url:site.contact.whatsapp,external:true,primary:true},{label:'Conhecer a Glifo',note:'Entre no nosso céu e percorra o site.',icon:'compass' as const,url:'/'},{label:'Explorar os trabalhos',note:'Cada projeto, uma linguagem própria.',icon:'collection' as const,url:'/trabalhos/'},{label:'Ver os documentos de marca',note:'Assinaturas, letras, cores e aplicações.',icon:'document' as const,url:'/identidades/'},{label:'Conhecer os serviços',note:'Encontre o formato para sua ideia.',icon:'spark' as const,url:'/#servicos'}];
const selection=['christiano-tadeu','delfas-corpore','tdv-editorial'].map(slug=>projects.find(p=>p.slug===slug)!);
---
<Base title="Glifo · Caminhos" description="Trabalhos, identidades e contato com Gabriel Tadeu. Escolha um caminho para conhecer a Glifo." minimal noindex bodyClass="bio-page">
 <section class="bio-hub" aria-labelledby="bio-title"><div class="bio-sky" aria-hidden="true"><svg viewBox="0 0 1000 1000"><ellipse cx="500" cy="430" rx="460" ry="355" transform="rotate(-28 500 430)"/><path d="M80 220L230 75L740 155L910 510L620 865L95 760M230 75L620 865M80 220L910 510"/>{[[80,220],[230,75],[740,155],[910,510],[620,865],[95,760]].map(([x,y])=><circle cx={x} cy={y} r="2"/>)}</svg></div><div class="bio-registration"><span>GLIFO / CARTA CELESTE</span><span>ESCOLHA UM CAMINHO</span></div><header class="bio-identity"><div class="bio-astrolabe"><svg viewBox="0 0 260 260" aria-hidden="true"><circle cx="130" cy="130" r="120"/><circle cx="130" cy="130" r="98"/>{Array.from({length:48},(_,i)=><path d={i%4===0?'M130 10V22':'M130 10V15'} transform={`rotate(${i*7.5} 130 130)`}/>)}<path d="M10 130H40M220 130H250M130 10V40M130 220V250"/></svg><img class="bio-emblem" src="/brand/symbol.png" alt="Emblema do grifo da Glifo" width="1254" height="1254"/></div><h1 id="bio-title"><img src="/brand/logo.png" alt="Glifo" width="1394" height="1128"/></h1><p class="eyebrow">IDEIA · FORMA · PRESENÇA</p><p>Identidades, sites e materiais<br/>{' '}desenhados por Gabriel Tadeu.</p><div class="bio-motto"><Motto variant="bio"/></div></header><div class="bio-destinations"><nav class="bio-links" aria-label="Escolha um caminho">{entries.map((entry,i)=><a href={entry.url} target={entry.external?'_blank':undefined} rel={entry.external?'noopener noreferrer':undefined} class:list={[{'bio-link-primary':entry.primary}]} style={`--arrival:${i*.065}s`}><span class="bio-link-sigil"><Icon name={entry.icon}/></span><span><strong>{entry.label}</strong><small>{entry.note}</small></span><span class="bio-link-direction"><small>0{i+1}</small><Icon name={entry.external?'arrow':'right'}/></span></a>)}</nav><aside class="bio-selected" aria-label="Uma amostra do acervo"><div><p class="eyebrow">Três figuras deste céu</p><a href="/trabalhos/">Ver o acervo <Icon/></a></div><div class="bio-work-strip">{selection.map(project=><a href={`/trabalhos/${project.slug}/`} class={`bio-work-${project.theme}`}><img src={project.image} alt={project.title} width="280" height="180" loading="lazy"/><span>{project.title}</span></a>)}</div></aside></div><footer class="bio-colophon"><span>Goiânia, GO · Por Gabriel Tadeu</span><span>© {new Date().getFullYear()} Glifo</span></footer></section>
</Base>
