---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import {site} from '../data/site';
const entries=[{label:'Conversar sobre um projeto',note:'Fale comigo pelo WhatsApp.',url:site.contact.whatsapp,external:true,primary:true},{label:'Conhecer a Glifo',note:'Percorra o site e o imaginário da marca.',url:'/'},{label:'Explorar os trabalhos',note:'Identidades, interfaces e coleções editoriais.',url:'/trabalhos/'},{label:'Ver os documentos de marca',note:'Cores, letras e escolhas de cada identidade.',url:'/identidades/'},{label:'Conhecer os serviços',note:'O que podemos construir para seu projeto.',url:'/#servicos'}];
---
<Base title="Glifo · Caminhos" description="Trabalhos, identidades e contato com Gabriel Tadeu. Escolha um caminho para conhecer a Glifo." minimal noindex bodyClass="bio-page">
 <section class="bio-hub" aria-labelledby="bio-title"><div class="bio-sky" aria-hidden="true"><svg viewBox="0 0 600 760"><ellipse cx="300" cy="350" rx="255" ry="320"/><path d="M80 220L230 75L430 155L510 410L320 665L95 560M230 75L320 665M80 220L510 410"/>{[[80,220],[230,75],[430,155],[510,410],[320,665],[95,560]].map(([x,y])=><circle cx={x} cy={y} r="2"/>)}</svg></div><header class="bio-identity"><img class="bio-emblem" src="/brand/symbol.png" alt="Emblema do grifo da Glifo" width="1254" height="1254"/><h1 id="bio-title"><img src="/brand/logo.png" alt="Glifo" width="1394" height="1128"/></h1><p class="eyebrow">IDEIA · FORMA · PRESENÇA</p><p>Identidades, sites e materiais<br/>desenhados por Gabriel Tadeu.</p></header><nav class="bio-links" aria-label="Escolha um caminho">{entries.map((entry,i)=><a href={entry.url} target={entry.external?'_blank':undefined} rel={entry.external?'noopener noreferrer':undefined} class:list={[{'bio-link-primary':entry.primary}]}><span class="bio-link-number">0{i+1}</span><span><strong>{entry.label}</strong><small>{entry.note}</small></span><Icon name={entry.external?'arrow':'right'}/></a>)}</nav><footer class="bio-colophon"><span>Goiânia, GO</span><span>© {new Date().getFullYear()} Glifo</span></footer></section>
</Base>
