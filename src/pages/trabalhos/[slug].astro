---
import Base from '../../layouts/Base.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';
import { projects,type Project } from '../../data/site';
export function getStaticPaths(){return projects.filter(p=>p.slug!=='glifo').map(project=>({params:{slug:project.slug},props:{project}}));}
interface Props {project:Project}
const {project:p}=Astro.props;
const related=projects.filter(x=>x.slug!==p.slug&&x.categories.some(c=>p.categories.includes(c))).slice(0,2);
---
<Base title={`${p.title} · Trabalhos da Glifo`} description={p.summary}><section class="page-intro wrap"><a href="/trabalhos/" class="quiet-link">← Trabalhos</a><p class="eyebrow">{p.label} / {p.year}</p><h1>{p.title}</h1><p class="project-lead">{p.lead}</p><p>{p.summary}</p><div class="case-meta">{p.categories.map(c=><span>{c}</span>)}</div></section><figure class="case-project-visual wrap"><ProjectVisual project={p} eager/><figcaption>{p.caption}</figcaption></figure><div class="case-project-details wrap"><div><span class="eyebrow">O trabalho</span><ul>{p.scope?.map(item=><li>{item}</li>)}</ul></div><div><span class="eyebrow">Estado do projeto</span><p>{p.status}</p>{p.external&&<a href={p.external.url} target="_blank" rel="noopener noreferrer" class="quiet-link">{p.external.label} ↗</a>}</div></div>{p.sections?.map((section,i)=><section class="section wrap case-text"><p class="eyebrow">0{i+1} / {p.title}</p><h2>{section.title}</h2><div><p class="big-copy">{section.text}</p></div></section>)}{p.gallery?.map(item=><figure class="case-support-image wrap"><img src={item.image} alt={item.alt} loading="lazy" width="1440" height="1000"/><figcaption>{item.caption}</figcaption></figure>)}<section class="case-related section wrap"><p class="eyebrow">Outras aproximações</p><div>{related.map(project=><a href={`/trabalhos/${project.slug}/`}><span>{project.categories.join(' / ')}</span><h3>{project.title} ↗</h3></a>)}</div></section><section class="case-end wrap"><h2>Há outros sinais<br/>a desenhar.</h2><a href="/#contato" class="line-link">Uma ideia em mente? ↗</a></section></Base>
