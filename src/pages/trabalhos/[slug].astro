---
import Base from '../../layouts/Base.astro';
import CaseBrief from '../../components/CaseBrief.astro';
import CaseEntry from '../../components/CaseEntry.astro';
import CaseMaterials from '../../components/CaseMaterials.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';
import { projects,type Project } from '../../data/site';
export function getStaticPaths(){return projects.filter(p=>p.slug!=='glifo').map(project=>({params:{slug:project.slug},props:{project}}));}
interface Props {project:Project}
const {project:p}=Astro.props;
const related=projects.filter(x=>x.slug!==p.slug&&x.categories.some(c=>p.categories.includes(c))).slice(0,2);
---
<Base title={`${p.title} · Trabalhos da Glifo`} description={p.summary}><section class="page-intro wrap"><a href="/trabalhos/" class="quiet-link">← Trabalhos</a><p class="eyebrow">{p.label} / {p.year}</p><h1>{p.title}</h1><p class="project-lead">{p.lead}</p><p>{p.summary}</p><div class="case-meta">{p.categories.map(c=><span>{c}</span>)}</div></section><CaseEntry project={p}/><figure class="case-project-visual wrap"><ProjectVisual project={p} eager/><figcaption>{p.caption}</figcaption></figure><CaseBrief project={p}/><div id="construcao"></div>{p.sections?.map((section,i)=><section class="section wrap case-text"><p class="eyebrow">0{i+1} / {p.title}</p><h2>{section.title}</h2><div>{section.text.split("\n\n").map(paragraph=><p>{paragraph}</p>)}</div></section>)}{p.materials?.length?<CaseMaterials project={p}/>:<section class="section wrap" id="materiais"><p class="eyebrow">Material do projeto</p><ProjectVisual project={p}/></section>}<section class="case-related section wrap"><p class="eyebrow">Outras aproximações</p><div>{related.map(project=><a href={`/trabalhos/${project.slug}/`}><span>{project.categories.join(' / ')}</span><h3>{project.title} ↗</h3></a>)}</div></section><section class="case-end wrap"><h2>Há outros sinais<br/>a desenhar.</h2><a href="/#contato" class="line-link">Uma ideia em mente? ↗</a></section></Base>
