---
import Base from '../../layouts/Base.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';
import { projects } from '../../data/site';
---
<Base title="Trabalhos · Glifo"><section class="page-intro wrap"><p class="eyebrow">A vitrine / Trabalhos</p><h1>Cada projeto,<br/>um céu próprio.</h1><p>A mesma atenção atravessa mundos diferentes. Percorra os trabalhos e conheça a relação entre a intenção, o desenho e seu uso.</p><div class="project-filters" role="group" aria-label="Filtrar trabalhos">{['Todos','Digital','Editorial','Identidade'].map((filter,i)=><button type="button" data-project-filter={filter} aria-pressed={i===0?'true':'false'}>{filter}</button>)}</div><p class="project-filter-count" data-project-filter-count role="status">{projects.length} trabalhos</p></section><section class="wrap project-index" aria-label="Projetos">{projects.map(p=><a href={`/trabalhos/${p.slug}/`} class="index-work" data-project-categories={p.categories.join(',')}><ProjectVisual project={p}/><div><p class="eyebrow">{p.label} / {p.year}</p><h2>{p.title}</h2><p>{p.summary}</p><span class="quiet-link">Explorar o projeto ↗</span></div></a>)}</section></Base>
