---
import ProjectConstellation from '../../components/ProjectConstellation.astro';
import Motto from '../../components/Motto.astro';
import Icon from '../../components/Icon.astro';
import Base from '../../layouts/Base.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';
import { projects,site } from '../../data/site';
const order=['christiano-tadeu','delfas-corpore','glifo','tadeon','tdv-editorial','nexos','acolher-comissao'];
const selection=order.map(slug=>projects.find(p=>p.slug===slug)!);
---
<Base title="Trabalhos · Glifo" bodyClass="work-directory"><section class="page-intro work-intro wrap"><div class="work-intro-copy"><p class="eyebrow">A vitrine / Trabalhos</p><h1>Cada projeto,<br/>um céu <em>próprio.</em></h1><p>Uma marca profissional, um livro, uma interface. Aqui, cada trabalho mostra como uma ideia ganhou desenho, organização e presença.</p><a href="/identidades/" class="quiet-link">Abrir os documentos de marca <Icon name="arrow"/></a></div><aside class="work-intro-aside" aria-label="O que você encontra nos projetos"><span class="work-intro-number">{String(projects.length).padStart(2,'0')}</span><p>Projetos para percorrer.<br/>Escolhas para examinar.</p><div class="work-intro-orbit" aria-hidden="true"><svg viewBox="0 0 250 100"><path d="M15 70L70 25L130 58L200 15L235 72M70 25L200 15M130 58L235 72"/>{[[15,70],[70,25],[130,58],[200,15],[235,72]].map(([x,y])=><circle cx={x} cy={y} r="2"/>)}</svg></div><span class="eyebrow">Identidade / Digital / Editorial</span></aside></section><section class="work-selection wrap" aria-label="Escolher uma área"><div class="project-filters" role="group" aria-label="Filtrar trabalhos">{['Todos','Digital','Editorial','Identidade'].map((filter,i)=><button type="button" data-project-filter={filter} aria-pressed={i===0?'true':'false'}>{filter}<span aria-hidden="true">{filter==='Todos'?projects.length:projects.filter(p=>p.categories.includes(filter)).length}</span></button>)}</div><p class="project-filter-count" data-project-filter-count role="status">{projects.length} trabalhos</p></section><section class="wrap project-index" aria-label="Projetos" data-work-index>{selection.map((p,i)=><a href={`/trabalhos/${p.slug}/`} class:list={['index-work',{'index-work-featured':i===0}]} data-project-categories={p.categories.join(',')} data-project-slug={p.slug}><ProjectVisual project={p}/><div class="work-card-copy"><div class="work-card-meta"><span>{String(i+1).padStart(2,'0')} / {p.label}</span><span>{p.year}</span></div><h2>{p.slug==='glifo'?<img class="work-card-logotype" src="/brand/logo.png" alt="Glifo" width="1394" height="1128"/>:p.title}</h2><p>{p.summary}</p><div class="work-card-bottom"><span>{p.categories.filter(c=>c!=='Direção visual').join(' / ')}</span><span class="work-card-arrow" aria-hidden="true"><Icon name="arrow"/></span></div><span class="quiet-link">Explorar o projeto <Icon name="arrow"/></span></div></a>)}</section><ProjectConstellation/><section class="work-index-end wrap"><div><p class="eyebrow">A próxima ideia</p><h2><Motto/></h2></div><a class="line-link" href={site.contact.whatsapp} target="_blank" rel="noopener noreferrer">Conversar com Tadeu <span aria-hidden="true"><Icon name="arrow"/></span></a></section></Base>
