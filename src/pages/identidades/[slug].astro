---
import Base from '../../layouts/Base.astro';
import IdentityBoard from '../../components/IdentityBoard.astro';
import {identities,type IdentityBoard as Board} from '../../data/identities';
export function getStaticPaths(){return identities.map(board=>({params:{slug:board.slug},props:{board}}));}
interface Props {board:Board}
const {board}=Astro.props;
---
<Base bodyClass={['ct','acolher','comissao'].includes(board.theme)?'identity-light-page':undefined} title={`${board.name} · Prancha de identidade`} description={board.intro}><IdentityBoard board={board}/></Base>
