---
import Icon from '../../components/Icon.astro';
import {projects} from '../../data/site';
import Base from '../../layouts/Base.astro';
import IdentityBoard from '../../components/IdentityBoard.astro';
import {identities,type IdentityBoard as Board} from '../../data/identities';
export function getStaticPaths(){return identities.map(board=>({params:{slug:board.slug},props:{board}}));}
interface Props {board:Board}
const {board}=Astro.props;
const paired=board.slug==='acolher';
const commission=identities.find(b=>b.slug==='comissao')!;
---
<Base bodyClass={['ct','acolher','comissao'].includes(board.theme)?'identity-light-page':undefined} title={`${paired?'Acolher e Grão de Mostarda':board.name} · Prancha de identidade`} description={board.intro}>{paired?<><header class="paired-identity-header wrap"><p class="eyebrow">Documento de duas identidades / {projects.find(p=>p.slug==='acolher-comissao')!.year}</p><h1>Acolher e<br/><em>Grão de Mostarda.</em></h1><p>A Comissão organiza os projetos; o Acolher dá forma a um desses encontros. As duas marcas aparecem aqui com suas próprias cores, letras e elementos.</p><div class="paired-document-marks"><a href="#acolher-identidade"><img src="/identities/acolher/acolher.webp" alt="Projeto Acolher" width="1000" height="1000"/><span>Conhecer o Acolher <Icon name="down"/></span></a><a href="#comissao-identidade"><img src="/identities/acolher/comissao.webp" alt="Comissão Grão de Mostarda" width="1000" height="1000"/><span>Conhecer a Comissão <Icon name="down"/></span></a></div><a href="/trabalhos/acolher-comissao/" class="quiet-link">Voltar ao projeto <Icon name="arrow"/></a></header><IdentityBoard board={board} embedded prefix="acolher-"/><IdentityBoard board={commission} embedded prefix="comissao-"/></>:<IdentityBoard board={board}/>}</Base>
