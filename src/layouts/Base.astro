---
import Icon from '../components/Icon.astro';
import ImageViewer from '../components/ImageViewer.astro';
import CoverTransition from '../components/CoverTransition.astro';
import Navigation from '../components/Navigation.astro';
import { site } from '../data/site';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/details.css';
import '../styles/observatory.css';
import '../styles/narrative.css';
import '../styles/portfolio.css';
import '../styles/identity-board.css';
import '../styles/identity-document.css';
import '../styles/portfolio-discovery.css';
import '../styles/client-journey.css';
import '../styles/finishing.css';
import '../styles/experience.css';
import '../styles/navigation.css';
import '../styles/bio-celestial.css';
import '../styles/mobile.css';
import '../styles/spatial.css';
import '../styles/editorial.css';
interface Props { title?: string; description?: string; bodyClass?: string; minimal?: boolean; noindex?: boolean; }
const {title = 'Glifo · Ideias que encontram forma', description = site.description, bodyClass,minimal=false,noindex=false} = Astro.props;
---
<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"/><title>{title}</title><meta name="description" content={description}/>{noindex&&<meta name="robots" content="noindex,follow"/>}<meta name="theme-color" content="#0C1020"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:image" content="/images/vision-board.webp"/><link rel="icon" type="image/png" href="/brand/symbol.png"/><link rel="apple-touch-icon" href="/brand/symbol.png"/><link rel="preload" href="/fonts/almendra-400.ttf" as="font" type="font/ttf" crossorigin/><link rel="preload" href="/fonts/manrope-400.woff2" as="font" type="font/woff2" crossorigin/><CoverTransition/></head>
<body class={bodyClass}><script is:inline>try{if(localStorage.getItem('glifo:motion')==='paused')document.documentElement.classList.add('motion-paused');}catch{}if(new URLSearchParams(location.search).has('documento'))document.documentElement.dataset.identityDocument='true';</script><div class="reading-progress" aria-hidden="true"><span data-reading-progress></span></div><a class="skip-link" href="#main">Ir para o conteúdo</a>
{!minimal&&<Navigation/>}
<main id="main"><slot/></main>
{!minimal&&<footer class="site-footer wrap">
 <div class="footer-brand"><a href="/" aria-label="Glifo, voltar ao início"><img class="footer-emblem" src="/brand/symbol.png" alt="Emblema do grifo" width="120" height="120" loading="lazy"/><img class="footer-logotype" src="/brand/logo.png" alt="Glifo" width="1394" height="1128" loading="lazy"/></a><p>{site.motto}<br/>Um estúdio de Gabriel Tadeu.</p></div>
 <nav aria-label="Explorar a Glifo"><h2>Explorar</h2><a href="/trabalhos/">Trabalhos</a><a href="/identidades/">Documentos de marca</a><a href="/#servicos">Serviços</a><a href="/#processo">O processo</a><a href="/#autor">Quem faz</a></nav>
 <nav aria-label="Áreas de trabalho"><h2>O que ganha forma</h2><a href="/#servicos">Identidades visuais</a><a href="/#servicos">Sites e interfaces</a><a href="/#servicos">Documentos e editorial</a><a href="/#servicos">Redes e comunicação</a></nav>
 <div class="footer-contact"><h2>Uma ideia em mente?</h2><a class="quiet-link" href={site.contact.whatsapp} target="_blank" rel="noopener noreferrer">Conversar com Tadeu <Icon name="arrow"/></a><p>(62) 98301-0176</p><a href="#main" class="back-top">Voltar ao início <Icon name="up"/></a></div>
 <div class="footer-colophon"><p>© {new Date().getFullYear()} Glifo · Gabriel Tadeu de Souza.</p><p>As marcas e os materiais apresentados pertencem aos respectivos projetos.</p><span>Goiânia, GO · Brasil</span></div>
</footer>}
<ImageViewer/><div class="feedback" role="status" aria-live="polite" data-feedback></div>
<dialog class="identity-document-dialog" data-identity-document aria-label="Documento de identidade da marca"><div class="identity-document-toolbar"><div><span>GLIFO / DOCUMENTO DE MARCA</span><strong data-identity-document-title></strong></div><a data-identity-document-route class="quiet-link" target="_blank" rel="noopener">Abrir em outra aba <Icon name="arrow"/></a><button type="button" data-identity-document-close aria-label="Fechar documento da marca">×</button></div><iframe title="Identidade visual e essência da marca" data-identity-document-frame></iframe></dialog>
<dialog class="idea-dialog" aria-labelledby="idea-title"><button class="dialog-close" type="button" data-close-dialog aria-label="Fechar">×</button><p class="eyebrow">Uma conversa começa por uma ideia</p><h2 id="idea-title">O que precisa<br/>ganhar forma?</h2><form data-idea-form data-whatsapp={site.contact.whatsapp}><label>Seu nome<input name="name" autocomplete="name" required maxlength="100"/></label><label>O que você tem em mente?<textarea name="idea" required minlength="10" maxlength="2000" rows="4" placeholder="Me conte sobre o projeto, o material ou a presença que você quer construir."></textarea></label><button class="line-link" type="submit">Preparar mensagem <span aria-hidden="true"><Icon name="arrow"/></span></button></form><div class="idea-result" hidden><p class="eyebrow">Sua ideia em palavras</p><textarea readonly aria-label="Mensagem preparada" data-idea-message rows="7"></textarea><div class="message-actions"><a class="line-link" data-send-idea href={site.contact.whatsapp} target="_blank" rel="noopener noreferrer">Abrir no WhatsApp <Icon name="arrow"/></a><button class="line-link" type="button" data-copy-idea>Copiar mensagem <Icon name="arrow"/></button><button class="quiet-button" type="button" data-edit-idea>Editar ideia</button></div><p class="small-note">Mensagem preparada para compartilhar com Tadeu. Nenhuma mensagem foi enviada.</p></div></dialog>
<script>import '../scripts/site';</script>
</body></html>
